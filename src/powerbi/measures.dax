----------------------------------------------------------------
-- Power BI DAX Measures
-- Project: Red Flags in EU Procurement Governance
--
-- Copy each measure into Power BI:
--   Right-click Table > New Measure > Paste
----------------------------------------------------------------

-- ============================================================
--  CORE AGGREGATIONS  (table: fact_tender)
-- ============================================================

Total Tenders = COUNTROWS(fact_tender)

Total Award Value = SUM(fact_tender[award_value_eur])

Avg Award Value = AVERAGE(fact_tender[award_value_eur])


-- ============================================================
--  RED FLAG COUNTS  (intermediate, not visualised directly)
-- ============================================================

F1 Count = CALCULATE([Total Tenders], fact_tender[F1] = TRUE())

F2 Count = CALCULATE([Total Tenders], fact_tender[F2] = TRUE())

F3 Count = CALCULATE([Total Tenders], fact_tender[F3] = TRUE())

F6 Count = CALCULATE([Total Tenders], fact_tender[F6] = TRUE())

Total Flagged = CALCULATE(
    [Total Tenders],
    fact_tender[F1] = TRUE() || fact_tender[F2] = TRUE() || fact_tender[F3] = TRUE()
    || fact_tender[F6] = TRUE()
)


-- ============================================================
--  RED FLAG RATES  (visualised — set Format = 0.0%)
-- ============================================================

F1 Rate = DIVIDE([F1 Count], [Total Tenders], 0)

F2 Rate = DIVIDE([F2 Count], [Total Tenders], 0)

F3 Rate = DIVIDE([F3 Count], [Total Tenders], 0)

F6 Rate = DIVIDE([F6 Count], [Total Tenders], 0)

Overall Flag Rate = DIVIDE([Total Flagged], [Total Tenders], 0)


-- ============================================================
--  GOVERNANCE  (table: dim_country — use AVG, never SUM)
-- ============================================================

Avg CPI = AVERAGE(dim_country[cpi_score])

Avg Control of Corruption = AVERAGE(dim_country[control_of_corruption])


-- ============================================================
--  PAGE 2 — FLAGGEN-SLICER TREND  (table: fact_tender)
--  In Power BI zuerst Tabelle anlegen:
--    Tabellentools > Neue Tabelle > DATATABLE-Code unten
--  Dann das Measure per Rechtsklick > Neues Measure einfuegen
-- ============================================================

-- 1. Tabelle (Tabellentools > Neue Tabelle > Code unten eingeben)
--
-- Flaggen = DATATABLE(
--     "Flag", STRING,
--     {
--         {"Einzelbieter"},
--         {"Wertdiskrepanz"},
--         {"Direktvergabe"},
--         {"Uberhoehter Preis"},
--         {"Gesamt (>=1 Flag)"}
--     }
-- )

-- 2. Measure (Rechtsklick fact_tender > Neues Measure)

Red Flag Trend =
    SWITCH(
        SELECTEDVALUE(Flaggen[Flag], "Einzelbieter"),
        "Einzelbieter",         [F1 Rate],
        "Wertdiskrepanz",       [F2 Rate],
        "Direktvergabe",        [F3 Rate],
        "Uberhoehter Preis",    [F6 Rate],
        "Gesamt (>=1 Flag)",    [Overall Flag Rate],
        [F1 Rate]
    )
